# ============================================================================
# CreateTokenSolana — Environment Variables (.env.local / Vercel)
# SECURITY NOTICE: Never expose RPC API keys in NEXT_PUBLIC_* variables.
# All browser RPC requests are routed through the server proxy (/api/rpc).
# ============================================================================

# Server-Only Solana RPC Endpoints (Used exclusively by Next.js API routes & /api/rpc)
SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_SERVER_ONLY_HELIUS_KEY"
SOLANA_DEVNET_RPC_URL="https://devnet.helius-rpc.com/?api-key=YOUR_SERVER_ONLY_HELIUS_DEVNET_KEY"

# Default public network selection ("mainnet-beta" or "devnet")
NEXT_PUBLIC_SOLANA_NETWORK="mainnet-beta"

# Official Service Fee Destination Wallet (Public Key only — safe for public display)
NEXT_PUBLIC_DEV_WALLET_ADDRESS="CP6teSg2LUxQsSBBtwZ9xjG2aZjjznhfCvGED9LNgjrJ"

# Product Funnel Analytics (Recommended: GA4 Measurement ID, e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
# Optional Google Ads Conversion ID (Leave blank unless running policy-compliant educational campaigns)
NEXT_PUBLIC_GOOGLE_ADS_ID=""

# Official Social & Support Links (Displayed in Footer & Schema.org sameAs)
NEXT_PUBLIC_SUPPORT_EMAIL="support@createtokensol.store"
NEXT_PUBLIC_SOCIAL_X_URL="https://x.com/CreateTokenSols"

# Distributed Rate Limiting & Replay Protection (Upstash Redis / Vercel KV REST API)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REDIS_REST_TOKEN"
# Optional Vercel KV aliases (supported automatically if Upstash vars are omitted):
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Decentralized Arweave / Irys Server Uploader (Server-Only)
# Base58-encoded Solana private key used on the server to fund Arweave uploads
IRYS_UPLOADER_PRIVATE_KEY=""

# Cloudinary Fallback Credentials (Server-Only)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Firebase / Firestore Configuration (Optional — used for persistent affiliate ledger)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
